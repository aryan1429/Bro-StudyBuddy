# LLM Provider Configuration
LLM_PROVIDER=ollama  # Options: openai, ollama, anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2  # or mistral, codellama, etc.

# Optional: OpenAI (if you switch provider later)
# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# Optional: Anthropic (if you switch provider later)
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=study_buddy_docs

# Database (PostgreSQL)
DATABASE_URL=postgresql://studybuddy:studybuddy123@postgres:5432/studybuddy

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,txt

# Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# RAG Settings
CHUNK_SIZE=1200
CHUNK_OVERLAP=300
TOP_K_RETRIEVAL=8
SIMILARITY_THRESHOLD=0.05

# CORS
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
