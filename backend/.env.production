# LLM Provider Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Optional: OpenAI (recommended for production)
# OPENAI_API_KEY=your-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# Optional: Groq (fast and free)
# GROQ_API_KEY=your-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=study_buddy_docs

# Database (PostgreSQL)
DATABASE_URL=postgresql://studybuddy:studybuddy123@postgres:5432/studybuddy

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,txt

# Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=6
SIMILARITY_THRESHOLD=0.7

# CORS - ADD YOUR PRODUCTION DOMAIN HERE
CORS_ORIGINS=https://brostudybuddy.live,http://brostudybuddy.live,http://frontend:3000

# JWT Authentication - CHANGE THIS IN PRODUCTION!
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars-PLEASE-CHANGE-THIS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth (optional) - ADD YOUR CREDENTIALS
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://brostudybuddy.live/auth/google/callback
